{
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/src/pages/Login.html"
    },
    {
      "source": "/cadastro",
      "destination": "/src/pages/cadastro.html"
    },
    {
      "source": "/dashboard",
      "destination": "/src/pages/telaInicial.html"
    },
    {
      "source": "/inicio",
      "destination": "/src/pages/telaInicial.html"
    }
  ],
  "redirects": [
    {
      "source": "/tutor-ia",
      "destination": "/src/pages/telaInicial.html#tutor-ia",
      "permanent": false
    },
    {
      "source": "/conteudos",
      "destination": "/src/pages/telaInicial.html#conteudos",
      "permanent": false
    },
    {
      "source": "/questoes",
      "destination": "/src/pages/telaInicial.html#questoes",
      "permanent": false
    },
    {
      "source": "/cronograma",
      "destination": "/src/pages/telaInicial.html#cronograma",
      "permanent": false
    },
    {
      "source": "/tarefas",
      "destination": "/src/pages/telaInicial.html#tarefas",
      "permanent": false
    },
    {
      "source": "/desempenho",
      "destination": "/src/pages/telaInicial.html#desempenho",
      "permanent": false
    }
  ]
}