{
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/src/pages/Login.html"
    },
    {
      "source": "/cadastro",
      "destination": "/src/pages/cadastro.html"
    },
    {
      "source": "/dashboard",
      "destination": "/src/pages/telaInicial.html"
    },
    {
      "source": "/inicio",
      "destination": "/src/pages/telaInicial.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/src/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/src/js/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/src/pages/Login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/src/pages/Login",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/Login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/src/pages/cadastro.html",
      "destination": "/cadastro",
      "permanent": true
    },
    {
      "source": "/src/pages/cadastro",
      "destination": "/cadastro",
      "permanent": true
    },
    {
      "source": "/cadastro.html",
      "destination": "/cadastro",
      "permanent": true
    },
    {
      "source": "/src/pages/telaInicial.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/src/pages/telaInicial",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/telaInicial.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/tutor-ia",
      "destination": "/dashboard#tutor-ia",
      "permanent": false
    },
    {
      "source": "/conteudos",
      "destination": "/dashboard#conteudos",
      "permanent": false
    },
    {
      "source": "/questoes",
      "destination": "/dashboard#questoes",
      "permanent": false
    },
    {
      "source": "/cronograma",
      "destination": "/dashboard#cronograma",
      "permanent": false
    },
    {
      "source": "/tarefas",
      "destination": "/dashboard#tarefas",
      "permanent": false
    },
    {
      "source": "/desempenho",
      "destination": "/dashboard#desempenho",
      "permanent": false
    }
  ]
}