<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AprovaDrive | Módulos 7 a 9</title>
<style>
:root{--v:#09664e;--a:#176ba5;--t:#263c3c}
*{box-sizing:border-box}
body{margin:0;font:16px/1.5 Arial,sans-serif;color:var(--t);
background:radial-gradient(circle at 10% 10%,#dff4e8,transparent 38%),
radial-gradient(circle at 90% 20%,#e3f2ff,transparent 38%),#f8fbf9}
main{max-width:790px;margin:25px auto;padding:0 15px}
header{padding:27px;border-radius:22px;background:linear-gradient(120deg,#07513f,#108062);color:white}
header h1{margin:10px 0;font-size:clamp(25px,5vw,38px)}
header p{margin:0;color:#dff8ec}
.marca{font-weight:900;letter-spacing:2px;color:var(--v);margin-bottom:18px}
.card{margin-top:18px;padding:25px;border-radius:20px;background:#ffffffd9;
box-shadow:0 15px 45px #0b503018;backdrop-filter:blur(10px)}
.info{display:flex;justify-content:space-between;color:var(--a);font-weight:bold;font-size:13px}
.barra{height:8px;margin:18px 0;background:#e2eee8;border-radius:20px;overflow:hidden}
.barra span{display:block;height:100%;background:var(--v)}
h2{font-size:22px;line-height:1.35}
.opcao{display:block;width:100%;margin:9px 0;padding:13px;text-align:left;
border:1px solid #d9e9e1;border-radius:11px;background:white;color:var(--t);
font:inherit;cursor:pointer}
.opcao:hover:not(:disabled){border-color:var(--v);background:#f2faf5}
.opcao:disabled{cursor:default}
.certa{background:#e6f7ed;border-color:#32aa70}
.errada{background:#fff0ed;border-color:#d98b7f}
.feedback{padding:13px;margin-top:16px;background:#eaf7ef;border-left:4px solid var(--v)}
button:focus-visible{outline:3px solid var(--a)}
.acoes{display:flex;justify-content:space-between;gap:10px;margin-top:22px}
.botao{padding:11px 16px;border:0;border-radius:10px;background:var(--v);
color:white;font-weight:bold;cursor:pointer}
.botao:disabled{opacity:.4;cursor:default}
.secundario{background:#eaf3ee;color:var(--v)}
</style>
</head>
<body>
<main>
<div class="marca">◆ APROVADRIVE</div>
<header>
  <small>10 QUESTÕES</small>
  <h1>Meio Ambiente e Cidadania</h1>
  <p>Módulos 7 a 9 · Mobilidade, cidadania e respeito</p>
</header>
<section class="card" id="quiz" aria-live="polite"></section>
</main>

<script>
const linhas = `
7|Mobilidade sustentável procura combinar:|Somente rapidez dos carros.|Acesso, segurança, inclusão e menor impacto ambiental.|Uso obrigatório de uma opção.|Fim de todas as ruas.|1|Mobilidade sustentável considera pessoas, infraestrutura e recursos.
7|Quando a bicicleta pode ser uma boa opção?|Em qualquer rota, mesmo perigosa.|Apenas para quem tem carro.|Quando distância e infraestrutura permitem uma viagem segura.|Somente quando não há ônibus.|2|Distância, condições pessoais e segurança devem ser avaliadas.
7|O transporte coletivo pode contribuir ao:|Transportar muitas pessoas por veículo.|Eliminar sozinho todo congestionamento.|Atender somente o centro.|Dispensar pontos de ônibus.|0|Ele atende várias pessoas em uma viagem.
7|Por que não há uma opção melhor para todas as viagens?|Segurança não importa.|Distância não importa.|Só o custo importa.|Necessidades e condições variam conforme a situação.|3|Considere segurança, acessibilidade, custo e disponibilidade.
8|Cidadania no trânsito significa:|Exigir prioridade sempre.|Seguir regras só com fiscalização.|Exercer direitos e cumprir deveres respeitando os outros.|Deixar tudo para os motoristas.|2|Cidadania inclui cooperação e responsabilidade.
8|Estacionar sobre a calçada pode:|Bloquear pedestres e dificultar a acessibilidade.|Beneficiar os pedestres.|Afetar somente o dono do carro.|Liberar a passagem.|0|Calçadas precisam permitir a circulação segura.
8|Quem deve colaborar para a boa convivência?|Somente agentes.|Somente motoristas.|Somente ciclistas.|Todos os usuários, conforme sua participação.|3|O trânsito é compartilhado por diferentes pessoas.
9|Ao passar perto de uma bicicleta, o motorista deve:|Manter afastamento seguro e evitar manobras bruscas.|Passar o mais perto possível.|Buzinar sem parar.|Presumir que o ciclista vai parar.|0|Distância e movimentos previsíveis reduzem riscos.
9|Perto de escolas, o correto é:|Acelerar antes da faixa.|Redobrar a atenção às crianças e à sinalização.|Ignorar crianças acompanhadas.|Parar sobre a calçada.|1|Crianças podem agir de forma inesperada.
9|Por que manter rampas e calçadas livres?|Para estacionar motos.|Porque só ciclistas usam rampas.|Para permitir circulação acessível e segura.|Para dispensar faixas de pedestres.|2|Esses espaços atendem pessoas com diferentes necessidades.
`.trim();

const perguntas = linhas.split("\n").map(linha => {
  const [modulo, texto, a, b, c, d, correta, explicacao] = linha.split("|");
  return { modulo, texto, opcoes:[a,b,c,d], correta:Number(correta), explicacao };
});

const quiz = document.querySelector("#quiz");
let atual = 0;
let respostas = Array(10).fill(null);

function mostrar() {
  const respondidas = respostas.filter(r => r !== null).length;

  if (atual === 10) {
    const acertos = perguntas.reduce(
      (total, p, i) => total + Number(respostas[i] === p.correta), 0
    );

    quiz.innerHTML = `
      <h2>Resultado: ${acertos}/10</h2>
      <p>Você concluiu os módulos 7 a 9.</p>
      <button class="botao" id="reiniciar">Refazer questões</button>
    `;

    document.querySelector("#reiniciar").onclick = () => {
      atual = 0;
      respostas = Array(10).fill(null);
      mostrar();
    };
    return;
  }

  const p = perguntas[atual];
  const marcada = respostas[atual];

  quiz.innerHTML = `
    <div class="info">
      <span>MÓDULO ${p.modulo} · QUESTÃO ${atual + 1}/10</span>
      <span>${respondidas}/10 respondidas</span>
    </div>
    <div class="barra"><span style="width:${respondidas * 10}%"></span></div>
    <h2>${p.texto}</h2>

    ${p.opcoes.map((opcao, i) => `
      <button class="opcao ${
        marcada !== null
          ? i === p.correta ? "certa" : i === marcada ? "errada" : ""
          : ""
      }" data-opcao="${i}" ${marcada !== null ? "disabled" : ""}>
        <strong>${"ABCD"[i]}.</strong> ${opcao}
      </button>
    `).join("")}

    ${marcada !== null ? `
      <div class="feedback">
        <strong>${marcada === p.correta
          ? "Resposta certa!"
          : `Correta: alternativa ${"ABCD"[p.correta]}.`}</strong>
        <br>${p.explicacao}
      </div>
    ` : ""}

    <div class="acoes">
      <button class="botao secundario" id="anterior"
        ${atual === 0 ? "disabled" : ""}>← Anterior</button>
      <button class="botao" id="proximo"
        ${marcada === null ? "disabled" : ""}>
        ${atual === 9 ? "Ver resultado" : "Próxima →"}
      </button>
    </div>
  `;

  quiz.querySelectorAll("[data-opcao]").forEach(botao => {
    botao.onclick = () => {
      respostas[atual] = Number(botao.dataset.opcao);
      mostrar();
    };
  });

  document.querySelector("#anterior").onclick = () => {
    atual--;
    mostrar();
  };

  document.querySelector("#proximo").onclick = () => {
    atual++;
    mostrar();
  };
}

mostrar();
</script>
</body>
</html>
